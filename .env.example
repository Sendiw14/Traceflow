# Copy to .env for local-dev. Never commit .env.
# Values here are local-only placeholders, not secrets.

TRACEFLOW_PROFILE=local-dev

# PostgreSQL (local-dev container only)
POSTGRES_USER=traceflow
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=traceflow

# trace-api
TRACEFLOW_DATABASE_URL=postgres://traceflow:local-dev-only-change-me@postgres:5432/traceflow?sslmode=disable
# 256-bit random token shared by the BFF and trace-api. Generate: openssl rand -hex 32
TRACEFLOW_SERVICE_TOKEN=
