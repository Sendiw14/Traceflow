# Create .env with `make env` (fills every empty secret below with random hex). Never commit .env.

TRACEFLOW_PROFILE=local-dev

# PostgreSQL superuser: used only by the one-shot `migrate` job.
POSTGRES_USER=traceflow
POSTGRES_PASSWORD=
POSTGRES_DB=traceflow

# Runtime database roles created by `trace-api migrate` (docs/architecture/data-model.md "DB roles").
TRACEFLOW_APP_DB_PASSWORD=
TRACEFLOW_RO_DB_PASSWORD=
TRACEFLOW_AUTH_DB_PASSWORD=

# 256-bit token shared by the web BFF and trace-api.
TRACEFLOW_SERVICE_TOKEN=
